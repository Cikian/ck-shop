# ==============================================================================
#  管理端本地开发配置示例
#
#  用法：复制本文件为同目录下的 .env，再按本机情况改端口（.env 已被 .gitignore 忽略）：
#      cp .env.example .env
#
#  ⚠️ .env 是「每台机器各自一份」的，不要提交；团队共享的构建配置在
#     .env.development / .env.production / .env.docker 等文件里。
# ==============================================================================

# port
VITE_PORT = 3100

#  网站标题
VITE_GLOB_APP_TITLE = Cikian

# 简称，此变量只能是字符/下划线
VITE_GLOB_APP_SHORT_NAME = Cikian

# 单点登录服务端地址
VITE_GLOB_APP_CAS_BASE_URL=http://cas.test.com:8443/cas

# 是否开启单点登录
VITE_GLOB_APP_OPEN_SSO = false

# 开启微前端模式
VITE_GLOB_APP_OPEN_QIANKUN=false

# 文件预览地址
VITE_GLOB_ONLINE_VIEW_URL=http://fileview.jeecg.com/onlinePreview


