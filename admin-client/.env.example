# ==============================================================================
#  管理端本地开发配置示例
#
#  用法：复制本文件为同目录下的 .env，再按本机情况改端口（.env 已被 .gitignore 忽略）：
#      cp .env.example .env
#
#  ⚠️ .env 是「每台机器各自一份」的，不要提交；团队共享的构建配置在
#     .env.development / .env.production / .env.docker 等文件里。
# ==============================================================================

# port
VITE_PORT = 3100

#  网站标题
VITE_GLOB_APP_TITLE = Cikian

# 简称，此变量只能是字符/下划线
VITE_GLOB_APP_SHORT_NAME = Cikian

# 单点登录服务端地址
VITE_GLOB_APP_CAS_BASE_URL=http://cas.test.com:8443/cas

# 是否开启单点登录
VITE_GLOB_APP_OPEN_SSO = false

# 开启微前端模式
VITE_GLOB_APP_OPEN_QIANKUN=false

# 文件预览地址
VITE_GLOB_ONLINE_VIEW_URL=http://fileview.jeecg.com/onlinePreview

# 登录页人机验证（CikVerify）验证码类型
# 可选：POW（工作量证明，默认）/ SLIDER / ROTATE / CONCAT / WORD_IMAGE_CLICK
# 必须与验证码平台给 appId 开通的类型一致；该值会写进 _app.config.js，发布后可直接改，无需重新打包
VITE_GLOB_CAPTCHA_TYPE = POW



# 传输口令 AES 加密的 key / iv（各 16 个字符）
# 必须与后端 ck-server/.env 的 JEECG_AES_KEY / JEECG_AES_IV 完全一致；
# 不一致时后端解出的口令是乱码，登录会一直提示“用户名或密码错误”。
# 真实值请向运维索取，写进 gitignored 的 .env / .env.local，勿提交到仓库。
VITE_AES_KEY=change-me-16chars
VITE_AES_IV=change-me-16chars
