# =============================================================================
# 管理端生产环境覆盖 —— 放到 /opt/ck-shop/admin-client/.env.production.local
# （已被 admin-client/.gitignore 忽略；Vite 中 .env.production.local 优先级高于 .env.production）
#
# 不写这个文件、直接用仓库里的 .env.production 会踩两个坑：
#   VITE_GLOB_API_URL=/jeecgboot          → 所有接口请求 404（后端 context-path 是 /api）
#   VITE_GLOB_DOMAIN_URL=...127.0.0.1...  → 上传/WebSocket 指向「用户自己的电脑」
#
# 写相对路径 /api 时，代码会自动拼成 window.location.origin + '/api'
# （admin-client/src/hooks/setting/index.ts:64-75），换域名不用重新打包。
# =============================================================================

VITE_GLOB_API_URL = /api
VITE_GLOB_DOMAIN_URL = /api
VITE_GLOB_API_URL_PREFIX =
VITE_PUBLIC_PATH = /

# 登录页人机验证类型。注意 .env.production 里写的是 POW（无交互，挡脚本弱），
# 这个文件优先级更高，改成 SLIDER 让生产用滑块；取值必须在 CikVerify 应用开通的 allowedTypes 内。
# 该值会写进 dist/_app.config.js，发布后可直接改，无需重打包。
VITE_GLOB_CAPTCHA_TYPE = SLIDER
