# =============================================================================
# 管理端「每台机器一份」的本地配置 —— 放到 /opt/ck-shop/admin-client/.env
# （admin-client/.env 已被 .gitignore 忽略，所以服务器上必须自己创建）
#
#   cp .env.example .env   # 再按下面填
#
# 这里只放「不能进 Git」的值（AES 密钥）和端口；接口地址等共享配置在
# .env.production / .env.production.local 里。
# =============================================================================

VITE_PORT = 3100
PORT = 3100

VITE_GLOB_APP_TITLE = Cikian
VITE_GLOB_APP_SHORT_NAME = Cikian

VITE_GLOB_APP_CAS_BASE_URL=http://cas.test.com:8443/cas
VITE_GLOB_APP_OPEN_SSO = false
VITE_GLOB_APP_OPEN_QIANKUN=false
VITE_GLOB_ONLINE_VIEW_URL=http://fileview.jeecg.com/onlinePreview

# 登录页人机验证类型：POW / SLIDER / ROTATE / CONCAT / WORD_IMAGE_CLICK
# ⚠️ 生产模式会被 .env.production 的 POW 覆盖 —— 要改生产值请写进 .env.production.local
VITE_GLOB_CAPTCHA_TYPE = POW

# ★ 各 16 位，必须与后端 /opt/ck-shop/ck-server/.env 的
#   JEECG_AES_KEY / JEECG_AES_IV 完全一致，否则登录永远提示「用户名或密码错误」
VITE_AES_KEY=换成16位密钥
VITE_AES_IV=换成16位向量
