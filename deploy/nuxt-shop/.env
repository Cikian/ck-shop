# =============================================================================
# 店铺端生产环境变量 —— 放到 /opt/ck-shop/nuxt-shop/.env
# （nuxt-shop/.env 已被 .gitignore 忽略，服务器上必须自己创建；也可先
#   cp .env.example .env 再对照本文件改）
#
# ⚠️ nuxt.config.ts 在【构建期】就会校验 AES_KEY/AES_IV/SIGN_SECRET/STORE_SITE_URL，
#    缺一个或仍是开源示例值 → 构建直接失败（这是故意的 fail-fast）。
# ⚠️ 构建与运行请用同一份 .env：runtimeConfig 里不少值在 build 时被写进产物。
# =============================================================================

# ---------- 后端 ----------
API_BASE_URL=http://127.0.0.1:9951/api
API_TIMEOUT_MS=10000
# API_READ_TIMEOUT_MS=3000

# ---------- 本站点身份（多店铺） ----------
STORE_CODE=default

# ---------- 密钥：必须与 ck-server/.env 一一对应 ----------
AES_KEY=换成16位与后端JEECG_AES_KEY一致
AES_IV=换成16位与后端JEECG_AES_IV一致
SIGN_SECRET=换成与后端JEECG_SIGNATURE_SECRET一致的长随机串
NUXT_OG_IMAGE_SECRET=换成OG图签名密钥

# ---------- 站点对外信息（影响 canonical / sitemap / OG / OAuth） ----------
STORE_SITE_URL=https://shop.example.com
STORE_SITE_NAME=Lautira
STORE_SITE_DESCRIPTION=Lautira 多店铺商城
STORE_PUBLIC_ORIGIN=https://shop.example.com

# ---------- 运行参数 ----------
# 生产必须 true；设 false 后浏览器拒收 Secure cookie，登录会直接失效
COOKIE_SECURE=true
# 只有本地验构建产物时才打开（并同时设 ALLOW_INSECURE_DEMO_SECRETS）
# ALLOW_INSECURE_SITE_URL=true

# ---------- 可选 ----------
# 多实例部署才需要；★ 必须在【构建前】写进本文件，它决定 Nitro storage 的 driver
# RATE_LIMIT_REDIS_URL=redis://:密码@127.0.0.1:6379/0
NUXT_PUBLIC_CAPTCHA_TYPE=SLIDER
# NUXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
