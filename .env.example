# =============================================================================
# 根目录 .env.example —— 仅供 docker-compose*.yml 使用
#
#   cp .env.example .env
#
# 说明：
#   1. `.env` 已被 .gitignore 忽略，绝对不要提交真实口令；
#   2. 下面两个口令只影响 compose 里的 MySQL / PostgreSQL 容器。
#      应用自身的数据库口令在 `ck-server/.env` 里，两处互不相干；
#   3. docker-compose*.yml 目前**无法在本仓库直接构建**（构建上下文指向
#      不存在的 ./jeecg-boot/、./jeecgboot-vue3/），详见这两个文件头部的说明。
# =============================================================================

# MySQL root 口令（jeecg-boot-mysql 容器）
# 不要使用 root / 123456 这类通用弱口令
COMPOSE_MYSQL_ROOT_PASSWORD=change-me

# PostgreSQL 口令（jeecg-boot-pgvector 容器）
COMPOSE_POSTGRES_PASSWORD=change-me
