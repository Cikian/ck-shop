# =============================================================================
# 环境变量示例 —— 复制为 .env 后按部署环境填写
#
#   cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，真实的密钥不要提交到仓库。
# =============================================================================

# Java 后端地址
API_BASE_URL=http://127.0.0.1:9951/api

# -----------------------------------------------------------------------------
# 店铺编码（多店铺必填）
#
# 一个管理端、多个前台：每个前台站点在**服务端**配置自己的店铺编码，
# BFF 调后端时通过 X-Store-Code 请求头带上它。这样
#   1) 分享出去的商品链接不带任何店铺参数（域名即店铺标识，链接更短）；
#   2) 浏览器拿不到也改不了，不存在前端传参被篡改的问题；
#   3) 后端据此过滤，A 店的商品不会出现在 B 店。
#
# 取值必须是后台【店铺管理】里维护的 code（如 digital / food / outdoor）。
# 留空时后端会按请求域名兜底匹配 ck_shop_store.domain，最后回退到默认店铺——
# 兜底仅便于本地开发，生产环境请务必显式配置。
# -----------------------------------------------------------------------------
STORE_CODE=default

# AES 加密 key / iv，必须与 Java 后端一致（向运维索取真实值，勿写死在仓库）
AES_KEY=change-me
AES_IV=change-me

# 接口签名密钥串，必须与 Java 后端一致（向运维索取真实值）
SIGN_SECRET=change-me

# OG 图片签名密钥
NUXT_OG_IMAGE_SECRET=change-me

# -----------------------------------------------------------------------------
# 站点对外信息（多店铺：每个前台站点填自己的域名与站名）
# 不填时回退到 http://localhost:3000 + "Lautira"，会让 canonical/sitemap/OG 出错
# -----------------------------------------------------------------------------
STORE_SITE_URL=https://shop.example.com
# 生产构建要求绝对 https 且非 localhost。仅本地验构建产物时，才在 .env 里显式设为 true。
# ALLOW_INSECURE_SITE_URL=true
STORE_SITE_NAME=Lautira
STORE_SITE_DESCRIPTION=Lautira 多店铺商城

# Google OAuth 回调用的本站 origin（生产必填，避免采信可伪造的 Host 头）
STORE_PUBLIC_ORIGIN=https://shop.example.com

# -----------------------------------------------------------------------------
# 运行参数
# -----------------------------------------------------------------------------
# 调用 Java 后端的超时（毫秒），避免后端卡住时挂死 Nitro 的 SSR 请求
API_TIMEOUT_MS=10000
# 公开读接口（GET）的超时，默认 3000；读不到就走页面降级，不让整页 SSR 白等
# API_READ_TIMEOUT_MS=3000

# 登录 cookie 是否带 Secure。默认 true；只有用 http 隧道/局域网 IP 调试时才设为 false
# （浏览器会拒收非 HTTPS 下的 Secure cookie，所以这个开关必须由部署者明确设置）
COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# 验证码（CikVerify）——前端只需同源接口路径，**不需要 appSecret**
#
# 默认走 SLIDER（滑块）。联调/自动化时可临时设为 POW（工作量证明，自动完成），
# 生产不要用 POW 代替滑块（它是无交互的，挡不住脚本）。
# 允许值：SLIDER / ROTATE / CONCAT / WORD_IMAGE_CLICK / POW
# -----------------------------------------------------------------------------
NUXT_PUBLIC_CAPTCHA_TYPE=SLIDER

# -----------------------------------------------------------------------------
# 危险开关：允许使用 JeecgBoot 开源默认密钥启动
# 默认不存在/为 false，此时密钥若是开源默认值会直接拒绝启动。
# 只在本地开发且暂时无法与后端一起轮换密钥时，才在被 gitignore 的 .env 里设为 true。
# -----------------------------------------------------------------------------
# ALLOW_INSECURE_DEMO_SECRETS=true
#
# 说明（清单 B17）：本仓库的本地 .env 已把 AES/SIGN 轮换成私有值，
# 与 ck-server/.env 的 JEECG_AES_KEY / JEECG_AES_IV / JEECG_SIGNATURE_SECRET 成对，
# 因此**不需要**再开这个开关。新环境请直接生成自己的密钥，而不是打开豁免。

# -----------------------------------------------------------------------------
# Google Analytics 4（普通接入，不接 Consent Mode）
#
# 测量 ID 形如 G-XXXXXXXXXX。优先用 NUXT_PUBLIC_GA4_ID（会暴露给客户端 JS，
# 供 app/plugins/ga4.ts 加载 gtag.js）；NUXT_GA4_ID 作为服务端兜底同样支持。
# 未配置时插件静默跳过，不加载 gtag.js，也不影响站点运行。
# -----------------------------------------------------------------------------
NUXT_PUBLIC_GA4_ID=

