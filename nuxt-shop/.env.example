# =============================================================================
# 环境变量示例 —— 复制为 .env 后按部署环境填写
#
#   cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，真实的密钥不要提交到仓库。
# =============================================================================

# Java 后端地址
API_BASE_URL=http://127.0.0.1:9951/api

# -----------------------------------------------------------------------------
# 店铺编码（多店铺必填）
#
# 一个管理端、多个前台：每个前台站点在**服务端**配置自己的店铺编码，
# BFF 调后端时通过 X-Store-Code 请求头带上它。这样
#   1) 分享出去的商品链接不带任何店铺参数（域名即店铺标识，链接更短）；
#   2) 浏览器拿不到也改不了，不存在前端传参被篡改的问题；
#   3) 后端据此过滤，A 店的商品不会出现在 B 店。
#
# 取值必须是后台【店铺管理】里维护的 code（如 digital / food / outdoor）。
# 留空时后端会按请求域名兜底匹配 ck_shop_store.domain，最后回退到默认店铺——
# 兜底仅便于本地开发，生产环境请务必显式配置。
# -----------------------------------------------------------------------------
STORE_CODE=default

# AES 加密 key / iv，必须与 Java 后端一致（向运维索取真实值，勿写死在仓库）
AES_KEY=change-me
AES_IV=change-me

# 接口签名密钥串，必须与 Java 后端一致（向运维索取真实值）
SIGN_SECRET=change-me

# OG 图片签名密钥
NUXT_OG_IMAGE_SECRET=change-me
