<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>jeecg-boot-module</artifactId>
        <groupId>org.jeecgframework.boot3</groupId>
        <version>3.9.5</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ck-shop</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-boot-base-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>ck-system</artifactId>
            <version>3.9.5</version>
            <scope>compile</scope>
        </dependency>

        <!-- MaxMind GeoLite2 City（离线 mmdb）地域解析；IP → 国家/省/市，契约 §5.5 -->
        <dependency>
            <groupId>com.maxmind.geoip2</groupId>
            <artifactId>geoip2</artifactId>
            <version>4.2.0</version>
        </dependency>

        <!-- CikVerify 验证码服务 Java SDK（线上正式发布版 1.0.0）。
             必须经 Maven 仓库（CikianMaven）引入；禁止本地 jar / 本地源码 / system scope。
             版本号由根 pom 的 ck.captcha.version 统一管理。 -->
        <dependency>
            <groupId>cn.cikian</groupId>
            <artifactId>captcha-client-spring-boot-starter</artifactId>
            <version>${ck.captcha.version}</version>
        </dependency>
    </dependencies>

</project>