<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.shop.product.mapper.ShopProductSkuCombinationMapper">

    <!-- 组合 + 规格值明细，用 collection 装配 specValueIds -->
    <resultMap id="SkuCombinationWithValuesMap" type="org.jeecg.modules.shop.product.entity.ShopProductSkuCombination">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="sku_code" property="skuCode"/>
        <result column="combination_key" property="combinationKey"/>
        <result column="combination_name" property="combinationName"/>
        <result column="price" property="price"/>
        <result column="stock" property="stock"/>
        <result column="image_url" property="imageUrl"/>
        <result column="saleable" property="saleable"/>
        <result column="del_flag" property="delFlag"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <collection property="specValueIds" ofType="java.lang.String">
            <result column="spec_value_id"/>
        </collection>
    </resultMap>

    <select id="selectByProductIdWithValues" resultMap="SkuCombinationWithValuesMap">
        SELECT c.id,
               c.product_id,
               c.sku_code,
               c.combination_key,
               c.combination_name,
               c.price,
               c.stock,
               c.image_url,
               c.saleable,
               c.del_flag,
               c.create_by,
               c.create_time,
               c.update_by,
               c.update_time,
               cv.spec_value_id
        FROM ck_shop_product_sku_combination c
        LEFT JOIN ck_shop_product_sku_combination_value cv
               ON cv.combination_id = c.id AND cv.del_flag = 0
        WHERE c.del_flag = 0
          AND c.product_id = #{productId}
        ORDER BY c.combination_key ASC, cv.id ASC
    </select>

    <select id="selectByProductIdsWithValues" resultMap="SkuCombinationWithValuesMap">
        SELECT c.id,
               c.product_id,
               c.sku_code,
               c.combination_key,
               c.combination_name,
               c.price,
               c.stock,
               c.image_url,
               c.saleable,
               c.del_flag,
               c.create_by,
               c.create_time,
               c.update_by,
               c.update_time,
               cv.spec_value_id
        FROM ck_shop_product_sku_combination c
        LEFT JOIN ck_shop_product_sku_combination_value cv
               ON cv.combination_id = c.id AND cv.del_flag = 0
        WHERE c.del_flag = 0
          AND c.product_id IN
        <foreach collection="productIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
        ORDER BY c.product_id ASC, c.combination_key ASC, cv.id ASC
    </select>

</mapper>
