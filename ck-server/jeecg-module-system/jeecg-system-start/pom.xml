<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>jeecg-module-system</artifactId>
        <groupId>org.jeecgframework.boot3</groupId>
        <version>3.9.5</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>jeecg-system-start</artifactId>
    
    <dependencies>
        <!-- SYSTEM 系统管理模块 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-system-biz</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
        <!-- shop 模块 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>ck-shop</artifactId>
            <version>3.9.5</version>
        </dependency>

        <!-- ck sys 模块 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>ck-system</artifactId>
            <version>3.9.5</version>
        </dependency>
        
        <!-- flyway 数据库自动升级 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>7.15.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-properties-migrator</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>


        <!-- 分库分表示例 -->
     <!--  <dependency>
           <groupId>org.jeecgframework.boot3</groupId>
           <artifactId>jeecg-cloud-test-shardingsphere</artifactId>
           <version>3.9.5</version>
       </dependency>-->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.jeecg.JeecgSystemApplication</mainClass>
                </configuration>
            </plugin>

            <!--
                Flyway CLI 入口（清单 B16）。

                为什么需要：spring.flyway.enabled=true 但 FlywayAutoConfiguration 被
                spring.autoconfigure.exclude 排除了（见 application-dev.yml，原因是
                spring.main.lazy-initialization=true 会干扰 Flyway 初始化），
                于是 `flyway/sql/mysql` 下的迁移脚本**从来没有被自动执行过**。

                这里把 flyway-maven-plugin 挂到本模块，让运维/开发可以显式跑：

                  # 查看状态（先看有没有 pending / mismatch）
                  mvn -pl jeecg-module-system/jeecg-system-start flyway:info \
                      -Dflyway.url=jdbc:mysql://127.0.0.1:3306/ck-shop \
                      -Dflyway.user=root -Dflyway.password=*** \
                      -Dflyway.locations=filesystem:./src/main/resources/flyway/sql/mysql \
                      -Dflyway.ignoreMigrationPatterns='*:missing'

                  # 修复历史表（清掉失败记录、对齐 checksum）
                  mvn ... flyway:repair   （参数同上）

                  # 执行迁移
                  mvn ... flyway:migrate  （参数同上）

                flyway-mysql 是 Flyway 10+ 拆出的数据库插件，缺它 Flyway 会报
                "No Flyway database plugin found to handle jdbc:mysql://..."。
            -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>12.4.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-mysql</artifactId>
                        <version>12.4.0</version>
                    </dependency>
                    <dependency>
                        <groupId>com.mysql</groupId>
                        <artifactId>mysql-connector-j</artifactId>
                        <version>${mysql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>