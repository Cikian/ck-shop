# =============================================================================
# 后端环境变量模板 —— 复制成 .env 后按环境填写
#
#   cp .env.example .env          （Linux / macOS）
#   copy .env.example .env        （Windows）
#
# 说明：
#   1. 由 Spring Boot 原生的 spring.config.import 加载，见
#      jeecg-module-system/jeecg-system-start/src/main/resources/application.yml；
#      因为 .env 没有自带 loader，所以引用时带扩展名提示：optional:file:../../.env[.properties]
#   2. 语法是 **properties**，不是 shell：
#        - KEY=VALUE，不要加引号、不要写 export
#        - 注释必须**独占一行**（# 开头）；行尾写 `KEY=值  # 说明` 会把说明当成值的一部分
#        - 值里的 @ ! 等符号原样写，不需要转义
#   3. .env 已被 .gitignore 忽略，**请勿提交真实值**；本模板可以提交，所以这里只留空值和说明。
#   4. 密码/密钥类**没有默认值**：缺失时启动会直接报
#      "Could not resolve placeholder 'XXX'"（故意的：宁可启动失败，也不要静默用错配置）。
# =============================================================================

# ---------- MySQL ----------
# 库地址；本机默认 127.0.0.1:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ck-shop
MYSQL_USERNAME=root
# 必填
MYSQL_PASSWORD=

# Druid 监控台（/api/druid）账号
DRUID_STAT_USERNAME=admin
# 必填，且不要用 123456 这类弱口令
DRUID_STAT_PASSWORD=

# ---------- Redis（登录态 / 缓存 / 分布式锁，也被 jeecg.redisson 与 ck.crydis 复用） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
# 无密码留空
REDIS_PASSWORD=

# ---------- MongoDB（ck-saas：首页轮播图等文档数据） ----------
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=ck-saas
MONGO_USERNAME=ck-saas
# 必填
MONGO_PASSWORD=

# ---------- 邮件（定时任务发信 + 店铺端邮箱验证码） ----------
# ⚠️ MAIL_USERNAME 必须是**完整邮箱地址**（含 @），不能只写域名。
#    写错的表现是 SMTP 535 认证失败，进而"验证码邮件发送失败"。
MAIL_HOST=
# 465=SSL（多数企业邮箱用这个），587=STARTTLS，25=明文。不填默认 465。
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 阿里云 OSS / 短信（JeecgBoot 内置上传与短信共用这对 AK/SK） ----------
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_SECRET_KEY=

# ---------- MinIO ----------
MINIO_URL=
MINIO_BUCKET=
MINIO_NAME=
MINIO_PASS=

# ---------- 又拍云（ck.oss：商城图片上传 + CDN） ----------
UPYUN_ENDPOINT=
UPYUN_BUCKET=
UPYUN_ACCESS_KEY=
# 必填
UPYUN_SECRET_KEY=
UPYUN_OBJECT_DIR_PREFIX=ck-saas

# ---------- 接口签名密钥（前后端、报表要一致；泄露即可伪造签名） ----------
# 必填，部署时换成长随机串（同时要改前端 SIGN_SECRET 与 signMd5Utils）
JEECG_SIGNATURE_SECRET=
JMREPORT_SIGNATURE_SECRET=

# ---------- 店铺端（ck-shop）----------
# 结算价格令牌签名密钥：非 dev 环境**必填**，留空会直接启动失败
# （PriceTokenUtils#validateSecret）。多实例部署必须各实例一致，否则用户无法下单。
CK_PRICE_TOKEN_SECRET=
# 结算价格令牌有效期（秒），默认 900
CK_PRICE_TOKEN_TTL_SECONDS=900
# 兜底店铺编码：仅当 ck.shop.allow-default-store-fallback=true 时才会用到。
# 非 dev 环境该开关一律为 false（解析不到店铺直接报错），因此这里通常不需要改。
CK_DEFAULT_STORE_CODE=default

# ---------- Knife4j / Swagger 文档账号 ----------
KNIFE4J_USERNAME=jeecg
# 生产环境建议关闭文档或改强口令
KNIFE4J_PASSWORD=

# ---------- 向量库（AI RAG 的 pgvector） ----------
PGVECTOR_HOST=
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=
PGVECTOR_USER=
PGVECTOR_PASSWORD=

# ---------- 第三方登录（GitHub OAuth） ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- 店铺端 Google 账号登录（C 端买家登录用） ----------
# 取自 Google Cloud Console → API 和服务 → 凭据 → OAuth 2.0 客户端 ID（Web 应用）。
# 两项留空时后端仍能正常启动，只是 /shop/account/google/auth-url 会返回
# "Google 登录尚未配置"的明确错误，前端据此禁用 Google 按钮（不影响邮箱登录）。
#
# ★ Google Cloud 的「已获授权的重定向 URI」必须**逐字匹配**下面这些值。
#   i18n 是 prefix 策略，所有语言都带前缀，所以路径是 /{lang}/auth/google/callback：
#     http://localhost:3000/zh/auth/google/callback
#     http://localhost:3000/en/auth/google/callback
#     http://localhost:3000/fr/auth/google/callback
#     https://your-domain.com/zh/auth/google/callback
#     https://your-domain.com/en/auth/google/callback
#     https://your-domain.com/fr/auth/google/callback
#   漏掉语言前缀或某个语言 → redirect_uri_mismatch（400）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 兜底回调地址，正常流程由请求 origin + 语言前缀推导，用不到此项。
GOOGLE_REDIRECT_URI=

# ---------- AI 相关 Key（不用的留空） ----------
AI_CHAT_API_KEY=
AI_DRAW_API_KEY=
AI_PIC_DRAW_API_KEY=
AI_VOICE_API_KEY=
AI_VIDEO_API_KEY=
AI_EMBED_API_KEY=
JMREPORT_AI_API_KEY=
BRAVE_SEARCH_API_KEY=
