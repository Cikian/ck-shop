# =============================================================================
# 后端环境变量模板 —— 复制成 .env 后按环境填写
#
#   cp .env.example .env          （Linux / macOS）
#   copy .env.example .env        （Windows）
#
# 说明：
#   1. 由 Spring Boot 原生的 spring.config.import 加载，见
#      jeecg-module-system/jeecg-system-start/src/main/resources/application.yml；
#      因为 .env 没有自带 loader，所以引用时带扩展名提示：optional:file:../../.env[.properties]
#   2. 语法是 **properties**，不是 shell：
#        - KEY=VALUE，不要加引号、不要写 export
#        - 注释必须**独占一行**（# 开头）；行尾写 `KEY=值  # 说明` 会把说明当成值的一部分
#        - 值里的 @ ! 等符号原样写，不需要转义
#   3. .env 已被 .gitignore 忽略，**请勿提交真实值**；本模板可以提交，所以这里只留空值和说明。
#   4. 密码/密钥类**没有默认值**：缺失时启动会直接报
#      "Could not resolve placeholder 'XXX'"（故意的：宁可启动失败，也不要静默用错配置）。
# =============================================================================

# ---------- MySQL ----------
# 库地址；本机默认 127.0.0.1:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ck-shop
MYSQL_USERNAME=root
# 必填
MYSQL_PASSWORD=

# Druid 监控台（/api/druid）账号
DRUID_STAT_USERNAME=admin
# 必填，且不要用 123456 这类弱口令
DRUID_STAT_PASSWORD=

# ---------- Redis（登录态 / 缓存 / 分布式锁，也被 jeecg.redisson 与 ck.crydis 复用） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
# 无密码留空
REDIS_PASSWORD=

# ---------- MongoDB（ck-saas：首页轮播图等文档数据） ----------
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=ck-saas
MONGO_USERNAME=ck-saas
# 必填
MONGO_PASSWORD=

# ---------- 邮件（定时任务发信） ----------
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 阿里云 OSS / 短信（JeecgBoot 内置上传与短信共用这对 AK/SK） ----------
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_SECRET_KEY=

# ---------- MinIO ----------
MINIO_URL=
MINIO_BUCKET=
MINIO_NAME=
MINIO_PASS=

# ---------- 又拍云（ck.oss：商城图片上传 + CDN） ----------
UPYUN_ENDPOINT=
UPYUN_BUCKET=
UPYUN_ACCESS_KEY=
# 必填
UPYUN_SECRET_KEY=
UPYUN_OBJECT_DIR_PREFIX=ck-saas

# ---------- 接口签名密钥（前后端、报表要一致；泄露即可伪造签名） ----------
# 必填，部署时换成长随机串（同时要改前端 SIGN_SECRET 与 signMd5Utils）
JEECG_SIGNATURE_SECRET=
JMREPORT_SIGNATURE_SECRET=

# ---------- Knife4j / Swagger 文档账号 ----------
KNIFE4J_USERNAME=jeecg
# 生产环境建议关闭文档或改强口令
KNIFE4J_PASSWORD=

# ---------- 向量库（AI RAG 的 pgvector） ----------
PGVECTOR_HOST=
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=
PGVECTOR_USER=
PGVECTOR_PASSWORD=

# ---------- 第三方登录（GitHub OAuth） ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- AI 相关 Key（不用的留空） ----------
AI_CHAT_API_KEY=
AI_DRAW_API_KEY=
AI_PIC_DRAW_API_KEY=
AI_VOICE_API_KEY=
AI_VIDEO_API_KEY=
AI_EMBED_API_KEY=
JMREPORT_AI_API_KEY=
BRAVE_SEARCH_API_KEY=
